# ===== 敏感：绝不进 git =====
# 浏览器登录态（含金蝶会话 cookie/token）
chrome-profile/
chrome-profile/**
# 真实业务数据
data/
# 运行产物 / 日志（含客户名、金额、界面文本）
output/
logs/
# Python 缓存
__pycache__/
*.pyc
# 本地配置（可能含个人改动；config.yaml 本身无密码，但为安全默认忽略，用 config.example.yaml 模板）
config.yaml

# ===== 其他临时/系统文件 =====
*.log
.DS_Store
Thumbs.db

